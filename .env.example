# ============================================================
# RootRecall — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file with real keys.
# ============================================================

# ──────────────────────────────────────────────────────────────
# HINDSIGHT (server-side only — never use NEXT_PUBLIC_ for keys)
# ──────────────────────────────────────────────────────────────

# Your Hindsight API key from https://hindsight.vectorize.io
HINDSIGHT_API_KEY=

# The memory bank to use (create this in the Hindsight UI first)
HINDSIGHT_BANK=rootrecall-incidents
# Alias: HINDSIGHT_BANK_ID=rootrecall-incidents

# Hindsight base URL (default is fine for cloud-hosted)
HINDSIGHT_BASE_URL=https://hindsight.vectorize.io

# ──────────────────────────────────────────────────────────────
# LLM PROVIDER (server-side only — never use NEXT_PUBLIC_ for keys)
# ──────────────────────────────────────────────────────────────

# Provider: openai | anthropic | google | ollama | mock
LLM_PROVIDER=mock

# Your LLM API key (used server-side only)
LLM_API_KEY=

# Alternatively, provider-specific API keys are supported automatically:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY= (or GOOGLE_API_KEY=)

# Model to use (depends on provider)
# openai: gpt-4o-mini, gpt-4o
# anthropic: claude-3-5-sonnet-20241022
# google: gemini-2.0-flash
# ollama: llama3.2
LLM_MODEL=

# Custom base URL (optional, for Ollama or proxy setups)
LLM_BASE_URL=

# ──────────────────────────────────────────────────────────────
# CLIENT-SIDE (non-secret configuration visible to browser)
# ──────────────────────────────────────────────────────────────

# Bank name shown in the UI (not a secret — just a string)
NEXT_PUBLIC_HINDSIGHT_BANK=rootrecall-incidents

# LLM provider name shown in UI (not a secret — just a label)
NEXT_PUBLIC_LLM_PROVIDER=mock

# Model name shown in UI (not a secret — just a label)
NEXT_PUBLIC_LLM_MODEL=
